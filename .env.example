# Server
CORS_ORIGINS=http://localhost:5173
DATA_DIR=data/generated
RUNTIME_DIR=data/runtime

# OpenAI-compatible LLM provider. Keep this server-side only.
# For a direct OpenAI key, leave LLM_BASE_URL blank.
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=
LLM_ENABLED=true

# Retrieval-grounded investigation guidance. The bundled corpus contains
# project-authored source cards with links and reuse notes, not copied PDFs.
RAG_ENABLED=true
RAG_TOP_K=3
RAG_CORPUS_PATH=backend/app/knowledge/open_sources.json
# "tfidf" is the dependency-free baseline. Set to "qdrant" to use local
# FastEmbed vectors plus Qdrant metadata filters.
RAG_BACKEND=tfidf
RAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Leave QDRANT_URL blank to use Qdrant local mode at QDRANT_LOCAL_PATH.
# For Docker Compose, use http://qdrant:6333. For Qdrant Cloud, set its URL
# plus QDRANT_API_KEY.
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=triage_guidance
QDRANT_LOCAL_PATH=data/runtime/qdrant

# Optional MLflow tracing. Default traces contain only redacted workflow metadata.
# Set MLFLOW_LANGCHAIN_AUTOLOG=true only for approved synthetic/non-sensitive data;
# it may capture LangChain prompt and response content.
MLFLOW_ENABLED=false
MLFLOW_TRACKING_URI=
MLFLOW_EXPERIMENT=AD-TriAgent
MLFLOW_LANGCHAIN_AUTOLOG=false

# Optional Slack notifications. Leave unset to run in local demo mode.
SLACK_WEBHOOK_URL=
