# Server
CORS_ORIGINS=http://localhost:5173
DATA_DIR=data/generated
RUNTIME_DIR=data/runtime

# OpenAI-compatible LLM provider. Keep this server-side only.
# For a direct OpenAI key, leave LLM_BASE_URL blank.
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=
LLM_ENABLED=true

# Optional collaboration connectors. Leave unset to run in local demo mode.
SLACK_WEBHOOK_URL=
AMBIGUOUS_API_BASE_URL=
AMBIGUOUS_API_TOKEN=
AMBIGUOUS_WORKSPACE_ID=
# Required only when Ambiguous (or an integration relay) can send verified events back.
AMBIGUOUS_WEBHOOK_SECRET=
